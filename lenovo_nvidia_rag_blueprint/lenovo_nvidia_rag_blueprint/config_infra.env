#!/usr/bin/env bash
# ============================================================================
# Infrastructure Configuration — setup_infra.sh
# ============================================================================
# Lenovo ThinkSystem SR650a V4 - GPU Inference Server
# 2x NVIDIA RTX PRO 6000 Blackwell (96GB each)
#
# This file contains ONLY the variables consumed by setup_infra.sh.
# Application-level config (NIM images, RAG settings) lives in config.env.
#
# GPU LAYOUT:
#
#   GPU 0 (96GB, non-MIG, dedicated — no time-slicing):
#     └── NIM LLM: Llama-3.3-Nemotron-Super-49B-v1.5 (NVFP4, TP1, ~54GB)
#         [Entire GPU dedicated to LLM for maximum throughput]
#
#   GPU 1 (96GB, MIG: 2x 1g.24gb + 1x 2g.48gb):
#     ├── MIG slice 0 (1g.24gb, time-sliced 2x):
#     │     NIM Embed  (llama-nemotron-embed-1b-v2,   ~3GB)
#     │     NIM Rerank (llama-nemotron-rerank-1b-v2, ~3.7GB)
#     ├── MIG slice 1 (1g.24gb, time-sliced 2x):
#     │     NIM Graphic Elements (nemotron-graphic-elements-v1)
#     │     NIM Table Structure  (nemotron-table-structure-v1)
#     └── MIG slice 2 (2g.48gb, time-sliced 3x):
#           NIM OCR           (nemoretriever-ocr-v1)
#           NIM Page Elements (nemotron-page-elements-v3)
#           Triton Inference Server (general ML)
#
# ============================================================================

# === CREDENTIAL STORE ===
CREDENTIAL_STORE="/root/.credentials/lenovo-rag"

# === HARDWARE ===
# GPU 0 = non-MIG, dedicated to LLM (full 96GB, no time-slicing)
# GPU 1 = MIG mode (see layout above)
LLM_GPU_INDEX=0
MIG_GPU_INDEX=1

# === MIG PROFILES (GPU 1) ===
# RTX PRO 6000 Blackwell supports: 1g.24gb (x4), 2g.48gb (x2), 4g.96gb (x1)
# We create: 2x 1g.24gb + 1x 2g.48gb = 24+24+48 = 96GB (full GPU 1)
# MIG slices are created by the GPU Operator's mig-manager (see mig-config-lenovo-2gpu.yaml).
MIG_PROFILE_SMALL="1g.24gb"
MIG_PROFILE_LARGE="2g.48gb"
MIG_SMALL_SLICE_COUNT=2
MIG_LARGE_SLICE_COUNT=1

# === TIME-SLICING ===
# Each MIG slice is shared by multiple pods via CUDA time-slicing.
#   1g.24gb slice 0 (2x): Embed + Rerank
#   1g.24gb slice 1 (2x): Graphic Elements + Table Structure
#   2g.48gb slice 2 (3x): OCR + Page Elements + Triton Inference Server
# GPU 0 is NOT time-sliced (dedicated to LLM, only 1 allocatable).
MIG_SMALL_TIME_SLICE_COUNT=2
MIG_LARGE_TIME_SLICE_COUNT=3

# === OPENSEARCH ===
OPENSEARCH_SNAP_CHANNEL="2/stable"
OPENSEARCH_NODE_NAME="cm0"
OPENSEARCH_PORT=9200

# === KUBERNETES ===
K8S_SNAP_CHANNEL="1.32-classic/stable"
K8S_NAMESPACE_INFERENCE="inference"
K8S_NAMESPACE_RAG="rag"
LB_IP_RANGE=""

# === NVIDIA GPU OPERATOR ===
GPU_OPERATOR_VERSION="v26.3.0"

# === JUJU (for monitoring — referenced by verify_deployment.sh) ===
JUJU_CONTROLLER_NAME="lenovo-controller"
COS_MODEL_NAME="cos"
